# EscrowLens environment template — copy to .env and fill in.
# NEVER put real keys in this file or in git.

# --- Chain (Monad testnet) ---
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143

# --- Contract (filled after deploy) ---
NEXT_PUBLIC_ESCROW_CONTRACT=

# --- Privy embedded wallets (client) ---
# Create at https://dashboard.privy.io ; enable Monad testnet (10143)
# or a custom chain. Questions: monad@privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# --- AI arbiter (SERVER-SIDE ONLY — never exposed to the browser) ---
# Primary: Kimi (Moonshot) — https://platform.moonshot.ai  (kimi-k2.6)
LLM_PROVIDER=kimi
KIMI_API_KEY=
# Fallback: Qwen (Alibaba) — https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (qwen3.8-max)
QWEN_API_KEY=
# EIP-712 signing key of the arbiter address baked into the contract.
# Fund NOT required (signs off-chain only) — but MUST equal ARBITER_ADDRESS
# used at deploy time.
ARBITER_PRIVATE_KEY=

# --- Deploy (forge script only; not used by the Next.js app) ---
DEPLOYER_PRIVATE_KEY=
ARBITER_ADDRESS=

# --- IPFS via Pinata (optional; app works fully without it) ---
IPFS_API_KEY=
IPFS_API_SECRET=
